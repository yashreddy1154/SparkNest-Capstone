    <decisions>
        <name>Check_Enquiry_Type</name>
        <label>Check Enquiry Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Target_Queue</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Enquiry Type</defaultConnectorLabel>
        <rules>
            <name>Is_Care_Plan</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Enquiry.Enquiry_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Care Plan</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Enquiry.Enquiry_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Care Plan Enquiry</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Care_Plan_Queue</targetReference>
            </connector>
            <label>Is Care Plan</label>
        </rules>
    </decisions>
